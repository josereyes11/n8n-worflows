    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json)\n  .sort((a, b) => (a.date || '').localeCompare(b.date || ''));\n\nconst fmt = d => d ? d.split('-').reverse().join('.') : '';   // 2026-11-17 → 17.11.2026\nconst tint = { Rejected: '#fdecec', Interview: '#e8f6ec', Applied: '#fff8e1' };\n\nconst count = s => rows.filter(r => r.status === s).length;\nconst month = rows.length\n  ? new Date(rows.at(-1).date).toLocaleString('en-GB', { month: 'long', year: 'numeric' })\n  : '';\n\nconst tr = rows.map(r => `\n  <tr style=\"background:${tint[r.status] || '#fff'}\">\n    <td>${fmt(r.date)}</td>\n    <td>${r.company || ''}</td>\n    <td>${r.position || ''}</td>\n    <td>${r.icon || ''} ${r.status || ''}</td>\n  </tr>`).join('');\n\nconst html = `<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>Applications ${month}</title>\n<style>\n  body { font-family: -apple-system, Helvetica, Arial, sans-serif; margin: 40px; color: #111; }\n  h1 { font-size: 20px; margin: 0 0 4px; }\n  p  { margin: 0 0 20px; color: #555; font-size: 13px; }\n  table { width: 100%; border-collapse: collapse; font-size: 12px; }\n  th { text-align: left; border-bottom: 2px solid #111; padding: 6px 8px; }\n  td { border-bottom: 1px solid #e5e5e5; padding: 6px 8px; vertical-align: top; }\n  @media print { body { margin: 15mm; } tr { break-inside: avoid; } }\n</style></head><body>\n  <h1>Applications – ${month}</h1>\n  <p>José Reyes · ${rows.length} applications · 🟡 ${count('Applied')} Applied · 🟢 ${count('Interview')} Interview · 🔴 ${count('Rejected')} Rejected</p>\n  <table>\n    <thead><tr><th>Date</th><th>Company</th><th>Position</th><th>Status</th></tr></thead>\n    <tbody>${tr}</tbody>\n  </table>\n</body></html>`;\n\nreturn [{ json: { html } }];"
      },
