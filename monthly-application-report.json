    {
      "parameters": {
        "jsCode": "const priority = { Rejected: 3, Interview: 2, Applied: 1 };\nconst icons = { Rejected: '🔴', Interview: '🟢', Applied: '🟡' };\nconst groups = {};\n\nfor (const item of $input.all()) {\n  const { date, company, position, status } = item.json;\n  if (!company) continue;\n\n  const key = company.toLowerCase().trim();\n  const g = groups[key] ??= { company, date, position: '', status: 'Applied' };\n\n  if (date < g.date) g.date = date;\n  if (!g.position && position) g.position = position;\n  if ((priority[status] || 0) > priority[g.status]) g.status = status;\n}\n\nreturn Object.values(groups)\n  .map(g => ({ json: { ...g, icon: icons[g.status] } }))\n  .sort((a, b) => a.json.date.localeCompare(b.json.date));"
      },
      "type": "n8n-nodes-base.code",
